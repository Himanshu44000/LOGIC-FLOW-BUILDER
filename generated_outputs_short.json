    "firstLines": [
      "import java.net.URI;",
      "import java.net.http.HttpClient;",
      "import java.net.http.HttpRequest;",
      "import java.net.http.HttpResponse;",
      "import java.time.Duration;",
      "public class Main_Testing {",
      "  public static void main(String[] args) throws Exception {",
      "  // Start",
      "  int count = 3;",
      "  int sum = 0;",
      "  for (int i = 1; i <= 3; i += 1) {",
      "    sum = sum + i;",
      "    if (i > 1) {",
      "      Thread.sleep(300);",
      "      var apiData = request(\"GET\", \"https://jsonplaceholder.typicode.com/todos/1\", null);",
      "      System.out.println(apiData);",
      "    } else {",
      "      System.out.println(sum);",
      "    }",
      "  }",
      "  while (count > 0) {",
      "    count = count - 1;",
      "  }",
      "  }",
      "",
      "  private static String request(String method, String url, String body) throws Exception {",
      "    HttpClient client = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(10)).build();",
      "    HttpRequest.Builder builder = HttpRequest.newBuilder()",
      "      .uri(URI.create(url))",
      "      .timeout(Duration.ofSeconds(10))",
      "      .header(\"Content-Type\", \"application/json\");",
      "",
      "    switch (method.toUpperCase()) {",
      "      case \"POST\":",
      "      case \"PUT\":",
      "      case \"PATCH\":",
      "        builder.method(method.toUpperCase(), HttpRequest.BodyPublishers.ofString(body == null ? \"\" : body));",
      "        break;",
      "      default:",
      "        builder.GET();",
      "    }",
      "",
      "    HttpResponse<String> response = client.send(builder.build(), HttpResponse.BodyHandlers.ofString());",
      "    return response.body();",
      "  }",
      "}"
    ],
    "warnings": []
  },
  "cpp": {
    "firstLines": [
      "#include <string>",
      "#include <array>",
      "#include <cstdio>",
      "#include <chrono>",
      "#include <thread>",
      "#include <iostream>",
      "",
      "std::string request(const std::string& method, const std::string& url, const std::string& body) {",
      "  (void)method; // method is unused in this lightweight helper",
      "  std::array<char, 128> buffer;",
      "  std::string result;",
      "#ifdef _WIN32",
      "  FILE* pipe = _popen((\"curl -s \" + url).c_str(), \"r\");",
      "#else",
      "  FILE* pipe = popen((\"curl -s \" + url).c_str(), \"r\");",
      "#endif",
      "  if (!pipe) return std::string();",
      "  while (fgets(buffer.data(), buffer.size(), pipe) != nullptr) {",
      "    result += buffer.data();",
      "  }",
      "#ifdef _WIN32",
      "  _pclose(pipe);",
      "#else",
      "  pclose(pipe);",
      "#endif",
      "  return result;",
      "}",
      "",
      "int main() {",
      "  // Start",
      "  int count = 3;",
      "  int sum = 0;",
      "  for (int i = 1; i <= 3; i += 1) {",
      "    sum = sum + i;",
      "    if (i > 1) {",
      "      std::this_thread::sleep_for(std::chrono::milliseconds(300));",
      "      auto apiData = request(\"GET\", \"https://jsonplaceholder.typicode.com/todos/1\", std::string());",
      "      std::cout << apiData << std::endl;",
      "    } else {",
      "      std::cout << sum << std::endl;",
      "    }",
      "  }",
      "  while (count > 0) {",
      "    count = count - 1;",
      "  }",
      "}"
    ],
